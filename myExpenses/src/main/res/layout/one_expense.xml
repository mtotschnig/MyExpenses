                    <org.totschnig.myexpenses.ui.AmountInput android:id="@+id/OriginalAmount" style="@style/TransactionFormField" android:contentDescription="@string/content_description_original_amount" app:downStreamDependency="@id/Amount" app:purpose="@string/menu_original_amount" app:withCurrencySelection="true" app:withExchangeRate="true" app:withTypeSwitch="false" />
                </LinearLayout>
                <LinearLayout android:id="@+id/EquivalentAmountRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/EquivalentAmountLabel" style="@style/TransactionFormLabel" android:text="@string/menu_equivalent_amount" />
