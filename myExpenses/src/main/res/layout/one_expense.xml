                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/AmountRow" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="6dp">
                        <TextView android:id="@+id/AmountLabel" style="@style/TransactionFormLabel" ns2:ignore="LabelFor" android:text="@string/amount" />
                        <org.totschnig.myexpenses.ui.AmountInput android:id="@+id/Amount" style="@style/TransactionFormField" android:visibility="gone" ns2:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/CategoryRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/CategoryLabel" style="@style/TransactionFormLabel" android:labelFor="@+id/Category" android:text="@string/category" />
                    <LinearLayout style="@style/TransactionFormField" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/Category" style="@style/TransactionFormSmallButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_weight="1" android:text="@string/select" />
                        <ImageView android:id="@+id/ClearCategory" style="?actionButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:tooltipText="@string/content_description_clear_category" android:contentDescription="@string/content_description_clear_category" android:focusable="true" android:visibility="gone" app:srcCompat="@drawable/ic_menu_close_clear_cancel" ns2:ignore="UnusedAttribute" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/AccountRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/AccountLabel" style="@style/TransactionFormLabel" android:labelFor="@+id/Account" android:text="@string/account" />
