                <LinearLayout android:id="@+id/RecurringToggleRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp" android:background="@drawable/transaction_field_outline" android:paddingStart="12dp" android:paddingEnd="12dp" android:minHeight="56dp">
                    <CheckBox android:id="@+id/RecurringToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical" android:text="@string/transaction_recurring" android:textColor="@color/transaction_text" android:buttonTint="@color/transaction_accent" />
                </LinearLayout>
                <LinearLayout android:id="@+id/OriginalAmountRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
