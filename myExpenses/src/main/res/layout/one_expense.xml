                    <org.totschnig.myexpenses.ui.AmountInput android:id="@+id/TransferAmount" style="@style/TransactionFormField" app:withTypeSwitch="false" />
                </LinearLayout>
                <LinearLayout android:id="@+id/TransferAccountRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
