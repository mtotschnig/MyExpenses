                    <Spinner android:id="@+id/TransferAccount" style="@style/TransactionFormField" />
                </LinearLayout>
                <LinearLayout android:id="@+id/SplitRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/SplitLabel" style="@style/TransactionFormLabel" android:text="@string/split_parts_heading" />
                    <LinearLayout style="@style/TransactionFormField" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_weight="1" android:orientation="vertical">
                            <org.totschnig.myexpenses.ui.ContextAwareRecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingHorizontal="10dp" android:text="@string/no_split_parts" />
                            <View android:id="@+id/unsplit_separator" android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:colorForeground" android:visibility="gone" />
                            <RelativeLayout android:id="@+id/unsplit_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                                <TextView android:id="@+id/label" style="@style/titleTextStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/end" android:text="@string/unsplit_amount" />
                                <TextView android:id="@+id/end" style="@style/titleTextStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" ns2:text="END" />
                            </RelativeLayout>
                            <View android:id="@+id/BottomLine" android:layout_width="match_parent" android:layout_height="4dp" android:background="?android:colorForeground" android:visibility="gone" />
                        </LinearLayout>
                        <ImageView android:id="@id/CREATE_PART_COMMAND" style="?actionButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:focusable="true" app:srcCompat="@drawable/ic_menu_add" ns2:ignore="ContentDescription" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/DebtRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/DebtLabel" style="@style/TransactionFormLabel" android:labelFor="@+id/Debt" android:text="@string/debt" />
                    <LinearLayout style="@style/TransactionFormField" android:orientation="horizontal">
                        <CheckBox android:id="@+id/DebtCheckBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_weight="1" />
                        <ImageView android:id="@+id/DebtSummaryPopup" style="?actionButtonStyle" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:scaleType="centerCrop" android:visibility="gone" app:srcCompat="@drawable/ic_menu_help" ns2:ignore="ContentDescription" />
                    </LinearLayout>
                </LinearLayout>
                <include android:id="@+id/TagRow" layout="@layout/tag_row" />
                <LinearLayout android:id="@+id/PlanRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/PlanLabel" style="@style/TransactionFormLabel" android:labelFor="@id/Recurrence" android:text="@string/transaction_reminder" />
                    <androidx.constraintlayout.widget.ConstraintLayout style="@style/TransactionFormField">
                        <Spinner android:id="@+id/Recurrence" style="@style/RecurrenceRowRecurrence" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                        <CheckBox android:id="@+id/LastDay" style="@style/RecurrenceRowLastDay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="@string/recurrence_last_day_of_month" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/Recurrence" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/Recurrence" app:layout_constraintTop_toTopOf="@id/Recurrence" />
                        <org.totschnig.myexpenses.ui.DateButton android:id="@+id/PB" style="@style/RecurrenceRowDateButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:visibility="gone" app:layout_constraintEnd_toStartOf="@id/PlanExecution" ns2:ignore="MissingConstraints" />
                        <CheckBox android:id="@+id/PlanExecution" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="@string/plan_automatic" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/PB" app:layout_constraintEnd_toEndOf="@id/EditPlan" app:layout_constraintStart_toEndOf="@+id/PB" app:layout_constraintTop_toTopOf="@id/PB" />
                        <ImageView android:id="@+id/EditPlan" style="?actionButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:tooltipText="@string/content_description_edit_plan" android:contentDescription="@string/content_description_edit_plan" android:focusable="true" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/PB" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/PlanExecution" app:layout_constraintTop_toTopOf="@id/PB" app:srcCompat="@drawable/ic_menu_edit" ns2:ignore="UnusedAttribute" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/AttachmentsRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView style="@style/TransactionFormLabel" android:labelFor="@id/newAttachment" android:text="@string/attachments" />
                    <com.google.android.flexbox.FlexboxLayout android:id="@+id/AttachmentGroup" style="@style/TransactionFormField" android:layout_height="wrap_content" android:animateLayoutChanges="true" app:dividerDrawable="@drawable/divider" app:flexWrap="wrap" app:justifyContent="flex_start" app:showDivider="middle">
                        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/newAttachment" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/menu_add" android:scaleType="center" app:srcCompat="@drawable/ic_menu_add" app:strokeColor="#FF888888" app:strokeWidth="4dp" />
                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/DefaultActionRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/DefaultActionLabel" style="@style/TransactionFormLabel" android:labelFor="@+id/DefaultAction" android:text="@string/default_action" />
                    <Spinner android:id="@+id/DefaultAction" style="@style/TransactionFormField" android:entries="@array/template_default_action_entries" />
                </LinearLayout>
                <LinearLayout android:id="@+id/advanceExecutionRow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/advanceExecutionLabel" style="@style/TransactionFormLabel" android:labelFor="@id/advanceExecutionSeek" android:text="@string/advance_exexcution_in_days" />
                    <LinearLayout style="@style/TransactionFormField">
