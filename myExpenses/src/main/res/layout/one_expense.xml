                </LinearLayout>
                <LinearLayout android:id="@+id/TransferAmountRow" android:visibility="gone" ns2:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
