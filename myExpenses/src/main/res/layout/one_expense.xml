                    <TextView android:id="@+id/CommentLabel" style="@style/TransactionFormLabel" android:labelFor="@+id/Comment" android:text="@string/notes" />
                    <LinearLayout style="@style/TransactionFormField" android:orientation="horizontal">
                        <EditText android:id="@+id/Comment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_weight="1" android:importantForAutofill="no" android:inputType="textCapSentences|textMultiLine" android:minHeight="@dimen/accessibility_clickable_minimum" android:hint="@string/notes" android:textColor="@color/transaction_text" android:background="@android:color/transparent" />
                        <Spinner android:id="@+id/Status" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center_vertical" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/DateAmountRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp" android:layoutDirection="ltr">
                    <LinearLayout android:id="@+id/DateTimeRow" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/DateTimeLabel" style="@style/TransactionFormLabel" android:text="@string/date" />
                        <LinearLayout style="@style/TransactionFormField" android:orientation="horizontal">
