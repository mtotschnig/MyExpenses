    <string name="next_settings_explain_mlkit_script">Lateinisch für die meisten europäischen Sprachen, z. B. Deutsch und Englisch.</string>
    <string name="next_settings_explain_backup_file_prefix">Hilft, Sicherungen mehrerer Geräte auseinanderzuhalten.</string>
    <string name="next_settings_explain_allow_screenshot">Bildschirmfotos der App und ihre Vorschau bei den zuletzt genutzten Apps. Ausgeschaltet bleibt der Bildschirm dort schwarz.</string>
    <string name="next_settings_explain_widget_protection">Zeigt seinen Inhalt auf dem Startbildschirm auch, während die App gesperrt ist.</string>
    <string name="next_settings_explain_sync_backends">Cloud oder Server, über die Konten mit anderen Geräten abgeglichen werden.</string>
    <string name="next_settings_explain_default_transfer_category">Kategorie, die neue Umbuchungen bekommen.</string>
